# 复制为 .env 后填写；不要提交真实 Key
ALI_API_KEY=

# 百炼 OpenAI 兼容接口
TWIN_AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 当前使用免费额度模型；充值后可改成 qwen-plus / qwen3.7-text-embedding 等
TWIN_CHAT_MODEL=deepseek-v4.1-flash
TWIN_EMBEDDING_MODEL=qwen3.7-text-embedding-flash
TWIN_EMBEDDING_DIMENSIONS=1024
TWIN_CHAT_ENABLE_THINKING=false

# 可选：rerank（免费额度 1M，按月/按量）
TWIN_RERANK_ENABLED=true
TWIN_RERANK_BASE_URL=https://dashscope.aliyuncs.com/api/v1
TWIN_RERANK_MODEL=qwen3.7-text-rerank

# 前端来源，多个用逗号分隔
TWIN_CORS_ALLOWED_ORIGINS=https://home.nobeladam.cn

# 限流
TWIN_RATE_LIMIT_PER_MINUTE=10
TWIN_RATE_LIMIT_PER_DAY_PER_IP=100
TWIN_RATE_LIMIT_GLOBAL_PER_DAY=500
